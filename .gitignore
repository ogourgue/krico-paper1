# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Aggregated data (data/aggregated.nc) and rendered figures (*.png) are
# committed: the repo README promises that reproducing a figure needs only
# plot.py, without the 56 GB recruitment dataset behind it. MS1 is the
# exception (see below): its aggregation is too large to track, so it alone
# needs aggregate.py re-run on the HPC.
**/*.pdf

# Downloaded sea-ice concentration files (F1; re-fetch with download_sic.sh,
# verify against F1_domain_map/sic_provenance.txt)
**/data/sic/

# Job logs (S1; sweep.sh writes to logs/)
**/logs/

# SLURM submission logs (dropped in the submission directory by ecsbatch)
ecsbatch.log.*

# FS2: data/aggregated.nc is committed, like the other aggregations. The
# _test file comes from --limit runs of FS2_currents/aggregate.py (~4.5 h
# batch job in full; see FS2_currents/README.md), the checkpoint is a resume
# artifact of a run, and the .out files are SLURM logs rather than sources.
FS2_currents/data/*_test.nc
FS2_currents/data/checkpoint.npz
FS2_currents/*.out

# MS1: the one-cohort aggregation holds daily positions for every particle
# (a few hundred MB) and needs the raw trajectories to regenerate; the frames
# are rendered from it by plot.py. See MS1_outcome_movie/README.md.
MS1_outcome_movie/data/aggregated.nc
MS1_outcome_movie/frames/
# The per-year series (job_series.sh) is not part of the paper: its
# aggregations, frames and movies stay local, only the scripts are tracked.
MS1_outcome_movie/series/
