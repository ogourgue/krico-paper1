# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Aggregated data (data/aggregated.nc) and rendered figures (*.png) are
# committed: the repo README promises that reproducing a figure needs only
# plot.py, without the 56 GB recruitment dataset behind it. FS2 is the one
# exception (see below): its aggregation is a mean field on the full 1/12
# degree grid, too large to track, so that figure alone needs aggregate.py
# re-run on a machine holding the GLORYS12 velocity fields.
**/*.pdf

# Downloaded sea-ice concentration files (F1; re-fetch with download_sic.sh,
# verify against F1_domain_map/sic_provenance.txt)
**/data/sic/

# Job logs (S1; sweep.sh writes to logs/)
**/logs/

# SLURM submission logs (dropped in the submission directory by ecsbatch)
ecsbatch.log.*

# FS2 exception: the mean circulation field is ~58 MB on disk on the full
# 1/12 degree grid, above what belongs in a figure repo. Regenerable by
# re-running FS2_currents/aggregate.py (~4.5 h batch job); see
# FS2_currents/README.md. The checkpoint is a resume artifact of that run,
# and the .out files are SLURM logs rather than sources.
FS2_currents/data/aggregated.nc
FS2_currents/data/checkpoint.npz
FS2_currents/*.out
